    {
      "id": "f38a0588-be4e-51ce-8a13-1701dd411b15",
      "name": "Webhook payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        860
      ],
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst t = $('Target').item.json;\nconst c = $('Get credentials').item.json;\nconst body = JSON.stringify({ event: 'post.publish', targetId: t.id, postId: t.postId, caption: t.caption, options: t.options, media: $('Get media').item.json.items, sentAt: new Date().toISOString() });\nconst sig = crypto.createHmac('sha256', c.signingSecret).update(body).digest('hex');\nconst headers = { 'content-type': 'application/json', 'x-relay-signature': sig };\nif (c.authHeader) headers['authorization'] = c.authHeader;\nreturn [{ json: { url: c.endpointUrl, body, headers } }];\n"
      }
    },
    {
      "id": "abd4ebde-10a3-55c8-bd90-d1d6be3af6e8",
      "name": "Send webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        860
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($json.headers) }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
