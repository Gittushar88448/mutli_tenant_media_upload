    {
      "id": "dac50989-538f-5c70-8eb7-a4b681559df9",
      "name": "FB request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        620
      ],
      "parameters": {
        "jsCode": "\nconst t = $('Target').item.json;\nconst first = $('Get media').item.json.items[0];\nconst page = t.account.externalId;\nif (t.postType === 'text' || !first) return [{ json: { url: `https://graph.facebook.com/v21.0/${page}/feed`, body: { message: t.caption, link: t.options.link || undefined } } }];\nif (first.kind === 'video') return [{ json: { url: `https://graph-video.facebook.com/v21.0/${page}/videos`, body: { file_url: first.url, description: t.caption } } }];\nreturn [{ json: { url: `https://graph.facebook.com/v21.0/${page}/photos`, body: { url: first.url, caption: t.caption } } }];\n"
      }
    },
    {
