        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ step: \"published\", executionId: $execution.id, platformPostId: $json.post_id || $json.id, permalink: \"https://facebook.com/\" + ($json.post_id || $json.id) }) }}"
      },
