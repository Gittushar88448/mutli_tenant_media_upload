    {
      "id": "e8fcec2a-83ad-5601-a185-132cb1d71017",
      "name": "IG container params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "\nconst t = $('Target').item.json;\nconst media = $('Get media').item.json.items;\nconst first = media[0];\nif (!first) throw new Error('NO_MEDIA');\nconst q = { caption: t.caption };\nif (t.postType === 'reel') { q.media_type = 'REELS'; q.video_url = first.url; q.share_to_feed = String(t.options.shareToFeed ?? true); if (t.options.audioName) q.audio_name = t.options.audioName; }\nelse if (t.postType === 'story') { q.media_type = 'STORIES'; first.kind === 'video' ? q.video_url = first.url : q.image_url = first.url; }\nelse if (first.kind === 'video') { q.media_type = 'REELS'; q.video_url = first.url; q.share_to_feed = 'true'; }\nelse { q.image_url = first.url; }\nreturn [{ json: { igUserId: t.account.externalId, resumeContainer: t.resume?.platformContainerId || null, query: q } }];\n"
      }
    },
