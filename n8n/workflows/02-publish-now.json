{
  "name": "Relay \u00b7 Publish now",
  "nodes": [
    {
      "id": "fb424ee7-dc3d-503b-bd3d-4622ebecf13f",
      "name": "Publish-now webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "relay-publish-now",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "relay-publish-now"
    },
    {
      "id": "f7ba86a1-b972-53e2-91d5-54c2abe15ef4",
      "name": "Check secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-relay-secret'] }}",
              "rightValue": "={{$env.RELAY_SHARED_SECRET}}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0eb45073-1905-5264-a8f5-22de0dbad7d3",
      "name": "Claim these targets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.RELAY_APP_URL}}/api/internal/targets/claim",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-relay-secret",
              "value": "={{$env.RELAY_SHARED_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ targetIds: $json.body.targetIds, limit: 100, workerId: \"n8n-now-\" + $execution.id }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "d7dd61bf-edf1-5ea2-9987-8fd40531ae2b",
      "name": "One item per target",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "targets",
        "options": {}
      }
    },
    {
      "id": "35977fe9-4ac1-5cc1-94a5-f31176ccc365",
      "name": "Publish target",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_PUBLISH_TARGET_WORKFLOW_ID"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    }
  ],
  "connections": {
    "Publish-now webhook": {
      "main": [
        [
          {
            "node": "Check secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check secret": {
      "main": [
        [
          {
            "node": "Claim these targets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim these targets": {
      "main": [
        [
          {
            "node": "One item per target",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per target": {
      "main": [
        [
          {
            "node": "Publish target",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "active": false,
  "pinData": {}
}