# --- Core -------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/relay
APP_URL=http://localhost:3000
# 32+ random chars: openssl rand -base64 48
AUTH_SECRET=
# 32 bytes, base64: openssl rand -base64 32  (encrypts social tokens at rest)
TOKEN_ENCRYPTION_KEY=
# Optional: separate secret for signed media URLs (defaults to AUTH_SECRET)
MEDIA_SIGNING_SECRET=
# Where uploads are stored when Cloudinary is not configured (local driver).
STORAGE_DIR=./storage
# Cloudinary: once set, new uploads and renders are stored there and served from its CDN.
# Either the single URL from Dashboard → API Keys, or the three values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary media library
CLOUDINARY_FOLDER=relay
# Set to "local" to keep using STORAGE_DIR even when Cloudinary keys are present.
STORAGE_DRIVER=

# Sandbox channels + in-process publishing simulator. Defaults to on outside production.
DEMO_MODE=true

# --- Sign in with Google ----------------------------------------------------------
# OAuth client (type "Web application") from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: APP_URL/api/auth/google/callback
# Leave empty to reuse GOOGLE_CLIENT_ID/SECRET below (add the redirect URI to that client).
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# --- n8n ----------------------------------------------------------------------
# Same value goes into n8n as RELAY_SHARED_SECRET
N8N_SHARED_SECRET=
# The "Relay · Publish now" workflow's production webhook URL
N8N_PUBLISH_NOW_WEBHOOK_URL=
# Optional comma-separated IPs allowed to call /api/internal/*
INTERNAL_IP_ALLOWLIST=

# --- Platform apps (leave empty to use sandbox channels) ----------------------
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Reddit "web app" from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Telegram, WhatsApp Cloud API, Discord, Slack, Bluesky and Mastodon need no app keys here.
# Each community is connected from the Communities page with its own bot token, webhook or
# app password, which Relay verifies and stores encrypted.

# --- Media rendering ------------------------------------------------------------
# Per-channel video cuts (trim, crop, soundtrack) are rendered with FFmpeg. Defaults to the
# binaries on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Music library: a free client id from devportal.jamendo.com. Without it, demo tracks are used.
JAMENDO_CLIENT_ID=

# --- Billing ------------------------------------------------------------------------
# Leave every key empty and plans switch instantly on the Billing page (demo).
# Razorpay is the only payment provider. Set its keys to take real payments.

# Razorpay (UPI, cards, netbanking; INR). Keys from Dashboard → Account & Settings → API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: APP_URL/api/billing/razorpay/webhook, with the subscription.* events
RAZORPAY_WEBHOOK_SECRET=
# Plan ids. `npm run razorpay:plans` creates all six from the INR prices in src/lib/plans.ts
# and prints these lines for you.
RAZORPAY_PLAN_CREATOR_MONTH=
RAZORPAY_PLAN_CREATOR_YEAR=
RAZORPAY_PLAN_STUDIO_MONTH=
RAZORPAY_PLAN_STUDIO_YEAR=
RAZORPAY_PLAN_AGENCY_MONTH=
RAZORPAY_PLAN_AGENCY_YEAR=
