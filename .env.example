# --- Core -------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/relay
APP_URL=https://kent-reaches-sep-solving.trycloudflare.com
# 32+ random chars: openssl rand -base64 48
AUTH_SECRET=
# 32 bytes, base64: openssl rand -base64 32  (encrypts social tokens at rest)
TOKEN_ENCRYPTION_KEY=
# Optional: separate secret for signed media URLs (defaults to AUTH_SECRET)
MEDIA_SIGNING_SECRET=
# Where uploads are stored (local driver). Swap lib/storage.ts for S3 in production.
STORAGE_DIR=./storage

# Sandbox channels + in-process publishing simulator. Defaults to on outside production.
DEMO_MODE=true

# --- n8n ----------------------------------------------------------------------
# Same value goes into n8n as RELAY_SHARED_SECRET
N8N_SHARED_SECRET=
# The "Relay · Publish now" workflow's production webhook URL
N8N_PUBLISH_NOW_WEBHOOK_URL=
# Optional comma-separated IPs allowed to call /api/internal/*
INTERNAL_IP_ALLOWLIST=

# --- Platform apps (leave empty to use sandbox channels) ----------------------
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
